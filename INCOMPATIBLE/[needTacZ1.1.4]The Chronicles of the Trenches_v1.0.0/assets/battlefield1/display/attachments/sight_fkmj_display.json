{
  "slot": "battlefield1:attachment/slot/sight_fkmj",
  // 配件的默认模型，不可为空
  "model": "battlefield1:attachment/sight_fkmj_geo",
  // 配件默认模型使用的材质，不可为空
  "texture": "battlefield1:attachment/uv/sight_fkmj",
  "lod": {
    "model": "battlefield1:attachment/lod/sight_fkmj_lod",
    "texture": "battlefield1:attachment/lod/sight_fkmj_lod"
  },
  "zoom": [
    2
  ],
  // 如果配件是瞄具，且为筒状放大瞄具，此选项应为true
  "scope": false,
  // 如果配件是瞄具，且为红点或全息瞄具，此选项应为true
  "sight": true,
  // 只有 瞄具 配件需要设置这个属性，表示开镜后，枪身和瞄具渲染的fov。
  // 默认情况下，mc 渲染手部模型的 fov 为 70。
  "fov": 30
}